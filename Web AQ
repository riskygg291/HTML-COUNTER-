        :root {
            --bg: #05050a;
            --card-bg: #0f0f1e;
            --neon-blue: #00d4ff;
            --neon-red: #ff2d55;
            --gold: #ffcc00;
            --glass: rgba(255, 255, 255, 0.05);
        }

        body {
            background-color: var(--bg);
            color: #fff;
            font-family: 'Oswald', sans-serif;
            margin: 0;
            padding: 20px;
            background-image: linear-gradient(45deg, #05050a 25%, #0a0a1f 50%, #05050a 75%);
        }

        header {
            text-align: center;
            padding: 40px 0;
            border-bottom: 2px solid var(--neon-blue);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.2);
            margin-bottom: 30px;
        }

        .stats-bar {
            background: var(--neon-red);
            color: #fff;
            display: inline-block;
            padding: 5px 15px;
            font-weight: bold;
            skew: -20deg;
            transform: skewX(-20deg);
            margin-bottom: 10px;
        }

        h1 { font-size: 3rem; text-transform: uppercase; margin: 10px 0; letter-spacing: 5px; }

        .search-container {
            max-width: 800px;
            margin: 20px auto;
            position: sticky;
            top: 10px;
            z-index: 100;
        }

        input {
            width: 100%;
            padding: 15px 25px;
            border-radius: 50px;
            border: 2px solid var(--neon-blue);
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            font-size: 1.2rem;
            box-shadow: 0 0 15px var(--neon-blue);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .hero-card {
            background: var(--card-bg);
            border: 1px solid var(--glass);
            padding: 20px;
            border-radius: 15px;
            position: relative;
            transition: 0.3s;
            overflow: hidden;
        }

        .hero-card:hover {
            transform: scale(1.05);
            border-color: var(--neon-red);
            box-shadow: 0 0 20px rgba(255, 45, 85, 0.3);
        }

        .hero-name {
            font-size: 1.5rem;
            color: var(--neon-blue);
            border-bottom: 1px solid var(--glass);
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
        }

        .role-tag { font-size: 0.7rem; color: var(--gold); text-transform: uppercase; }

        .counter-box {
            background: rgba(0, 0, 0, 0.3);
            padding: 10px;
            border-radius: 8px;
            margin-top: 10px;
        }

        .counter-item {
            color: #ff9fb2;
            font-weight: bold;
            margin-bottom: 5px;
            display: block;
        }

        .reason { color: #aaa; font-size: 0.8rem; font-style: italic; display: block; margin-bottom: 8px; }

        .footer-note { text-align: center; margin-top: 50px; color: var(--text-dim); font-size: 0.8rem; }
    </style>
